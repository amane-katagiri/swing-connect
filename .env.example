# node --env-file=.env build.mjs で読み込めます。空のままの変数は既定値（config.js の値）になります。

# 見た目（homepage / modern、既定 homepage）
SWING_CONNECT_THEME=

# ページの見出し（プレーンテキスト）
SWING_CONNECT_TITLE=

# 見出しの下の説明文（プレーンテキスト）
SWING_CONNECT_DESCRIPTION=

# URL の nip05 パラメータを使うか（true / false、既定 true）
SWING_CONNECT_NIP05=

# 既定の色（rrggbb か #rrggbb）。ライトモードは既定 0645ad、ダークモードは既定 7dff3c
SWING_CONNECT_LIGHT_COLOR=
SWING_CONNECT_DARK_COLOR=

# URL の light / dark パラメータで色を変えられるようにするか（true / false、既定 true）
SWING_CONNECT_CUSTOM_COLORS=

# 表示を許す公開鍵（npub / nprofile / hex をスペースかカンマ区切り）。空ならどの鍵でも表示する。
# 1 つだけ指定すると、key パラメータが無いときにその鍵のページになる
SWING_CONNECT_ALLOWED_KEYS=

# 「SWING をインストールする」のリンク先（既定 https://github.com/amane-katagiri/swing）
SWING_CONNECT_SWING_URL=
